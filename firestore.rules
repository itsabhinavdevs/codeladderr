rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // signed-in user can read/write only their own document and everything
    // nested under it (dailyGoals, longTermGoals, progress, questionData,
    // contributions, concepts — added in later phases, rule already covers
    // them via the recursive wildcard).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Any authenticated user can read admin notifications. Writes are locked
    // down for now; Phase 6 adds the hardcoded admin UID that may write here.
    match /notifications/{notificationId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Any authenticated user can read practice sheets and problems.
    // Writes are strictly denied (managed via admin scripts only).
    match /sheets/{sheetId}/{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
